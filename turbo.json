{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "GITHUB_ACTIONS",
    "RAILWAY_ENVIRONMENT",
    "VERCEL",
    "CI",
    "LOGTAIL_SOURCE_TOKEN",
    "LOG_LEVEL",
    "SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_RELEASE",
    "NEXT_RUNTIME",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_DOMAIN",
    "ALERT_EMAIL_TO",
    "ALERT_EMAIL",
    "SLACK_MIGRATION_WEBHOOK_URL",
    "BETTERSTACK_TOKEN",
    "MSG91_AUTH_KEY",
    "MSG91_TEMPLATE_ID",
    "ANTHROPIC_API_KEY",
    "AI_PRIMARY_MODEL",
    "AI_FALLBACK_MODEL",
    "OPENAI_API_KEY",
    "GEMINI_API_KEY",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "WHATSAPP_ENABLED",
    "WHATSAPP_TOKEN",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_VERIFY_TOKEN",
    "WHATSAPP_BUSINESS_ACCOUNT_ID",
    "META_APP_ID",
    "META_APP_SECRET",
    "GUPSHUP_API_KEY",
    "GUPSHUP_APP_NAME",
    "GUPSHUP_SOURCE_NUMBER",
    "GUPSHUP_WEBHOOK_SECRET",
    "AISENSY_API_KEY",
    "HEALTHCHECK_3DAY_URL",
    "HEALTHCHECK_7DAY_URL",
    "HEALTHCHECK_WHATSAPP_URL",
    "HEALTHCHECK_DAILY_REPORT_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "SEED_AUDIT_DIR",
    "SEED_ANONYMIZATION_SALT",
    "SKIP_TESTCONTAINERS",
    "VITEST_POOL_ID",
    "TEST_DATABASE_URL",
    "OUTBOX_ENABLED",
    "DRIFT_TRACKING_ENABLED",
    "PROMPT_VERSIONING_ENABLED",
    "DATA_QUALITY_ENABLED",
    "SHADOW_COMPARISON_ENABLED",
    "ADMIN_ROUTES_ENABLED",
    "JUDGE_GRADING_ENABLED",
    "SODA_ENABLED",
    "SODA_DATA_SOURCE",
    "SLACK_WEBHOOK_URL",
    "CRON_BACKEND",
    "QUEUE_REDIS_URL",
    "QUEUE_REDIS_URL",
    "REDIS_URL",
    "RESEND_API_KEY",
    "CSP_IP_HASH_SALT",
    "NEXT_PUBLIC_CSP_MODE",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_ACCOUNT_HASH",
    "CLOUDFLARE_IMAGES_API_TOKEN",
    "CLOUDFLARE_IMAGES_SIGNING_KEY",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_PRIVATE",
    "R2_BUCKET_PUBLIC",
    "R2_PUBLIC_HOSTNAME",
    "STORAGE_PROVIDER_PRIMARY",
    "MEDIA_SIGNED_UPLOAD_TTL_SECONDS",
    "MEDIA_SIGNED_READ_TTL_SECONDS",
    "CLOUDINARY_CLOUD_NAME",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "POSTHOG_API_KEY",
    "POSTHOG_PROJECT_KEY",
    "POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "FLAG_EVALUATION_AUDIT_SAMPLE_RATE",
    "FLAG_SYNC_INTERVAL_SECONDS",
    "FLAG_CACHE_L1_TTL_SECONDS",
    "FLAG_CACHE_L2_TTL_SECONDS",
    "HOSTNAME",
    "FEATURE_FLAGS_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^db:generate"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "db:generate": { "cache": false },
    "db:push": { "cache": false },
    "db:migrate:dev": { "cache": false },
    "db:migrate:deploy": { "cache": false },
    "db:studio": { "cache": false, "persistent": true },
    "db:seed": { "cache": false },
    "test": {
      "dependsOn": ["^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:watch": { "cache": false, "persistent": true },
    "test:coverage": {
      "dependsOn": ["^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*"],
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
