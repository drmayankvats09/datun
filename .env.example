# ═══════════════════════════════════════════════════════════════
# DATUN — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env or .env.local — only .env.example
# Source of truth: apps/api/src/config/env.ts (Zod schema)
# ═══════════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/datun_dev

# ── API Server ──
PORT=4000
NODE_ENV=development

# ── Auth (own system — NO Auth0) ──
JWT_SECRET=change-me-minimum-32-characters-long-random-string
JWT_REFRESH_SECRET=change-me-minimum-32-characters-different-random

# ── AI Providers ──
ANTHROPIC_API_KEY=sk-ant-...
AI_PRIMARY_MODEL=claude-sonnet-4-20250514
AI_FALLBACK_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── Email (Resend — primary) ──
RESEND_API_KEY=re_...
RESEND_FROM_DOMAIN=datunai.com
ALERT_EMAIL_TO=hello@datunai.com

# ── Email (AWS SES — fallback, optional) ──
# Activates automatically when all 3 vars set.
# Setup: AWS Console → SES → Verify domain → Request production access
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=ap-south-1

# ── SMS OTP (MSG91) ──
MSG91_AUTH_KEY=...
MSG91_TEMPLATE_ID=...

# ── Google OAuth ──
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── Sentry ──
SENTRY_DSN=https://...@sentry.io/...

# ── Redis (Upstash) ──
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── Queue Redis (Railway TCP — for BullMQ background jobs) ──
# Required in production. Use Railway's REDIS_URL from the Redis service.
QUEUE_REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Bull-Board dashboard auth ──
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-min-8-chars-strong-random

# ── Cron backend selection ──
# 'node-cron' (default during soak) — existing crons run, BullMQ scheduled idle
# 'bullmq' — BullMQ scheduled jobs run, node-cron disabled (after 7-day soak)
CRON_BACKEND=node-cron

# ── Worker concurrency (apps/worker only) ──
WORKER_CONCURRENCY_WHATSAPP=10
WORKER_CONCURRENCY_EMAIL=10
WORKER_CONCURRENCY_PDF=2
WORKER_CONCURRENCY_SCHEDULED=5

# ── WhatsApp (Meta Cloud API — primary) ──
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
META_APP_ID=...
META_APP_SECRET=...

# ── WhatsApp (Gupshup — fallback, optional) ──
# Activates when all 4 vars set. Setup: gupshup.io → create app → submit
# templates → copy API key. See docs/whatsapp-setup.md for spoonfeed.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_SECRET=

# ── WhatsApp (AiSensy — emergency, Year 2) ──
# Stub until activated. Set AISENSY_API_KEY to enable third tier.
AISENSY_API_KEY=

# ── Logging (Better Stack) ──
LOGTAIL_SOURCE_TOKEN=...

# ── Healthchecks.io ──
HEALTHCHECK_3DAY_URL=...
HEALTHCHECK_7DAY_URL=...
HEALTHCHECK_WHATSAPP_URL=...
HEALTHCHECK_DAILY_REPORT_URL=...

# ── Next.js (Web) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...

# ═══════════════════════════════════════════════════════════════
# CSP (Content Security Policy) — Task #45
# ═══════════════════════════════════════════════════════════════

# Web app: CSP enforcement mode.
#   'report-only' — emits Content-Security-Policy-Report-Only (Phase 2).
#   'enforce'     — emits Content-Security-Policy (Phase 3 — production).
# Default: report-only.
NEXT_PUBLIC_CSP_MODE=report-only

# API: salt for hashing IP addresses before persisting CSP violation reports.
# DPDP compliance requires that raw IPs not be stored. We hash via
# SHA-256(ip || salt) and store only the hash. Rotate quarterly.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSP_IP_HASH_SALT=replace-me-with-32-byte-random-hex-string


# ═══════════════════════════════════════════════════════════════
# MEDIA PIPELINE — Task #46
# ═══════════════════════════════════════════════════════════════

# Storage provider selection.
#   'r2'         — Cloudflare R2 origin (default). Reuses @aws-sdk/client-s3.
#   'cloudinary' — documented fallback adapter; activate only on R2 outage.
STORAGE_PROVIDER_PRIMARY=r2

# ── Cloudflare R2 (origin storage, S3-compatible) ──
# Activation: Cloudflare dashboard → R2 → Purchase R2 → Create bucket.
# Generate API token at R2 → Manage API Tokens with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket names (defaults are usable; override only for blue/green or staging).
R2_BUCKET_PRIVATE=datun-media-prod-private
R2_BUCKET_PUBLIC=datun-media-prod-public

# Public hostname for the public bucket. Either:
#   - Cloudflare custom domain attached to R2 (e.g., media.datunai.com), OR
#   - The default `<accountId>.r2.dev` URL (acceptable for staging only).
R2_PUBLIC_HOSTNAME=

# ── Cloudflare Images (delivery / variants / AVIF + WebP auto) ──
# Activation: Cloudflare dashboard → Images → Subscribe.
# Account hash is shown on the Images home page (used to build delivery URLs).
# API token: dashboard → My Profile → API Tokens with Cloudflare Images:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=

# ── Cloudinary (fallback adapter only — usually leave blank) ──
# Set these ONLY when toggling STORAGE_PROVIDER_PRIMARY=cloudinary during an
# R2 outage. The adapter is dormant until all three are populated.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Signed URL TTLs (seconds) ──
# Upload PUT URLs: long enough for slow rural 3G, short enough to defeat replay.
MEDIA_SIGNED_UPLOAD_TTL_SECONDS=300
# Read URLs for private clinical assets: renewed per request.
MEDIA_SIGNED_READ_TTL_SECONDS=300
# ═══════════════════════════════════════════════════════════════
# FEATURE FLAGS / POSTHOG — Task #49
# ═══════════════════════════════════════════════════════════════
# > TASK_49_POSTHOG:START
#
# PostHog acts as the admin console + remote source of truth for
# the feature-flag platform. The local DB cache (feature_flags
# table) is the authoritative read-path — if PostHog is down for
# hours, evaluation keeps serving the last-known state.
#
# ALL keys are OPTIONAL. With nothing set, the API runs in
# "DB-only mode" — flags managed exclusively through the admin UI
# at /admin/flags, no upstream PostHog sync. This is the
# day-one default; activate PostHog later when admin user count
# grows beyond the founding team.

# ── Server-side (apps/api) ──
#
# Personal API key for the PostHog REST endpoints used by the
# server-side sync worker (mirrors PostHog → DB every 60s).
# Looks like: phx_…
# Scopes required: feature_flag:read, feature_flag:write.
# Generate at: https://app.posthog.com/settings/user-api-keys
POSTHOG_API_KEY=

# Project API key (a.k.a. project capture key). Same value used in
# the browser as NEXT_PUBLIC_POSTHOG_KEY below.
# Looks like: phc_…
POSTHOG_PROJECT_KEY=

# PostHog Cloud or a self-hosted instance. Defaults to US Cloud.
POSTHOG_HOST=https://us.i.posthog.com

# ── Browser-side (apps/web) ──
#
# Next.js exposes vars prefixed with NEXT_PUBLIC_* in the client
# bundle. These mirror the server values so the browser SDK can
# initialise + bootstrap flags before the first paint.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Flag platform tuning (server-side only) ──
#
# Master kill for the flag platform itself. When false, the API
# evaluator returns every flag's hard-coded default. Useful when
# the flag platform itself is suspected during an incident.
FEATURE_FLAGS_ENABLED=true

# Probability (0..1) that an evaluation is persisted to the
# feature_flag_evaluations audit table. 0.01 = 1% sample.
# Tune downward at scale (>10K evals/sec) to control row volume.
FLAG_EVALUATION_AUDIT_SAMPLE_RATE=0.01

# Period (seconds) between PostHog → DB sync ticks.
FLAG_SYNC_INTERVAL_SECONDS=60

# In-memory L1 cache TTL (per API process). Lower = fresher reads,
# higher = lower DB load. 30 seconds = sane default.
FLAG_CACHE_L1_TTL_SECONDS=30

# Redis L2 cache TTL (cross-instance). Should be ≥ L1 TTL.
# Invalidated early via Redis pub/sub on admin mutations.
FLAG_CACHE_L2_TTL_SECONDS=60

# > TASK_49_POSTHOG:END

