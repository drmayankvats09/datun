# ═══════════════════════════════════════════════════════════════
# DATUN — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env or .env.local — only .env.example
# Source of truth: apps/api/src/config/env.ts (Zod schema)
# ═══════════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/datun_dev

# ── API Server ──
PORT=4000
NODE_ENV=development

# ── Auth (own system — NO Auth0) ──
JWT_SECRET=change-me-minimum-32-characters-long-random-string
JWT_REFRESH_SECRET=change-me-minimum-32-characters-different-random

# ── AI Providers ──
ANTHROPIC_API_KEY=sk-ant-...
AI_PRIMARY_MODEL=claude-sonnet-4-20250514
AI_FALLBACK_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ── Email (Resend) ──
RESEND_API_KEY=re_...
RESEND_FROM_DOMAIN=datunai.com
ALERT_EMAIL_TO=hello@datunai.com

# ── SMS OTP (MSG91) ──
MSG91_AUTH_KEY=...
MSG91_TEMPLATE_ID=...

# ── Google OAuth ──
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ── Sentry ──
SENTRY_DSN=https://...@sentry.io/...

# ── Redis (Upstash) ──
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...
META_APP_ID=...
META_APP_SECRET=...

# ── Logging (Better Stack) ──
LOGTAIL_SOURCE_TOKEN=...

# ── Healthchecks.io ──
HEALTHCHECK_3DAY_URL=...
HEALTHCHECK_7DAY_URL=...
HEALTHCHECK_WHATSAPP_URL=...
HEALTHCHECK_DAILY_REPORT_URL=...

# ── Next.js (Web) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...