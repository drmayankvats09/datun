{
  "name": "datun",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "node apps/api/dist/server.js",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs,yaml}\"",
    "verify": "turbo run check-types lint test:coverage build --force --concurrency=1",
    "check-translations": "cd apps/web && npx tsx scripts/check-translations.ts",
    "check-types": "turbo run check-types",
    "clean": "turbo run build --force && echo 'Cleaned all caches'",
    "fresh": "rm -rf node_modules apps/web/.next apps/api/dist .turbo && pnpm install",
    "prepare": "husky || true",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:push": "turbo run db:push --filter=@repo/db",
    "db:migrate:dev": "turbo run db:migrate:dev --filter=@repo/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@repo/db",
    "db:studio": "turbo run db:studio --filter=@repo/db",
    "db:seed": "turbo run db:seed --filter=@repo/db",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,mjs,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.14",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "esbuild": "^0.25.0",
      "vitest": "^3.2.4",
      "vite": "^5.4.10",
      "@vitest/coverage-v8": "^3.2.4",
      "@vitest/ui": "^3.2.4",
      "thrift": ">=0.23.0",
      "postcss": ">=8.5.10",
      "protobufjs": ">=8.0.2",
      "@aws-sdk/client-s3": "3.1042.0",
      "@aws-sdk/s3-request-presigner": "3.1042.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
