#!/usr/bin/env sh

# ═══════════════════════════════════════════════════════════════
# PRE-PUSH HOOK — Heavy verification (Mayank approved Day 16)
#
# Order:
#   1. Migration drift check (only if schema/migration files changed)
#   2. Full FAANG verify: types + lint + test + build (sequential)
#
# Total time: ~12-15 min on full project (saga test = 8 min biggest)
# Standard: Stripe/Vercel/Linear pre-push pattern (heavy mode)
# ═══════════════════════════════════════════════════════════════

# ─── Step 1: Migration drift check (conditional) ──────────────
changed=$(git diff --name-only @{u}..HEAD 2>/dev/null \
  | grep -E "^(packages/db/prisma/(schema\.prisma|migrations/)|packages/db/src/lib/)" || true)

if [ -n "$changed" ]; then
  echo "🦷 Migration files changed — running migration validation..."
  pnpm --filter @repo/db prisma validate

  if [ -n "${SHADOW_DATABASE_URL:-}" ]; then
    pnpm --filter @repo/db prisma migrate diff \
      --from-schema-datamodel packages/db/prisma/schema.prisma \
      --to-migrations packages/db/prisma/migrations \
      --shadow-database-url "$SHADOW_DATABASE_URL" \
      --exit-code || {
        echo ""
        echo "❌ Schema and migrations folder out of sync."
        echo "   Run: pnpm --filter @repo/db prisma migrate dev --name <change>"
        exit 1
      }
  else
    echo "   (drift check skipped — SHADOW_DATABASE_URL not set in shell)"
  fi
  echo "✓ Migration validation passed"
  echo ""
fi

# ─── Step 2: Full FAANG verification ──────────────────────────
echo "🔒 Pre-push: Running full FAANG verification..."
echo "   (check-types + lint + test:coverage + build, sequential, no cache)"
echo "   Estimated time: 12-15 minutes."
echo ""

pnpm verify

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Pre-push FAILED — fix errors before pushing."
  echo "   Re-run manually: pnpm verify"
  exit 1
fi

echo ""
echo "✅ Pre-push check passed — pushing to remote."