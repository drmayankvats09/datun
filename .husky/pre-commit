#!/usr/bin/env sh
# ═══════════════════════════════════════════════════════════════
# PRE-COMMIT HOOK — FAANG-grade Defense Layer 1 (Full Monorepo)
# Standard: Stripe / Vercel / Linear / Google / Meta pattern
# Time: ~2-4 min
# ═══════════════════════════════════════════════════════════════

set -e

echo ""
echo "🔍 Datun pre-commit checks (full monorepo)..."
echo ""

# ─── Step 1: lint-staged (Prettier on staged files) ─────────
echo "→ lint-staged (Prettier across all packages)..."
npx lint-staged
echo "  ✓ lint-staged passed"

# ─── Step 2: .env guard ─────────────────────────────────────
if git diff --cached --name-only | grep -qE "\.env$|\.env\.local$|\.env\.production$"; then
  echo ""
  echo "❌ Attempting to commit .env file. NEVER commit secrets."
  exit 1
fi
echo "  ✓ No .env files staged"

# ─── Step 3: Prisma validate (only if schema changed) ───────
if git diff --cached --name-only | grep -qE "^packages/db/prisma/schema\.prisma$"; then
  echo "→ Prisma schema validation..."
  pnpm --filter @repo/db exec prisma validate > /dev/null 2>&1 || {
    echo "❌ Prisma schema invalid."
    exit 1
  }
  echo "  ✓ Prisma schema valid"
fi

# ─── Step 4: TypeScript check (FULL monorepo) ───────────────
ts_files=$(git diff --cached --name-only | grep -E "\.(ts|tsx)$" || true)

if [ -n "$ts_files" ]; then
  echo "→ TypeScript check (turbo: ALL packages — db + api + web + worker + shared + ui)..."
  pnpm turbo run check-types --concurrency=2 2>&1 | tail -15
  if [ ${PIPESTATUS[0]:-$?} -ne 0 ]; then
    echo ""
    echo "❌ TypeScript errors. Fix before committing."
    echo "   Re-run: pnpm turbo run check-types"
    exit 1
  fi
  echo "  ✓ TypeScript clean (full monorepo)"
fi

# ─── Step 5: ESLint (FULL monorepo) ─────────────────────────
if [ -n "$ts_files" ]; then
  echo "→ ESLint (turbo: ALL packages)..."
  pnpm turbo run lint --concurrency=2 2>&1 | tail -15
  if [ ${PIPESTATUS[0]:-$?} -ne 0 ]; then
    echo ""
    echo "❌ ESLint errors. Fix before committing."
    echo "   Re-run: pnpm turbo run lint"
    exit 1
  fi
  echo "  ✓ ESLint clean (full monorepo)"
fi

# ─── Step 6: gitleaks secret scan ───────────────────────────
if ! command -v gitleaks > /dev/null 2>&1; then
  echo ""
  echo "⚠️  gitleaks not installed — skipping (CI will catch on push)."
  echo "✅ Pre-commit checks passed (gitleaks skipped)."
  exit 0
fi

if git diff --cached --quiet; then
  echo "✅ Pre-commit checks passed."
  exit 0
fi

echo "→ gitleaks secret scan..."
set +e
gitleaks git --pre-commit --staged --redact --no-banner --config=.gitleaks.toml --exit-code 1
GITLEAKS_EXIT=$?
set -e

if [ "$GITLEAKS_EXIT" -ne 0 ]; then
  echo ""
  echo "❌ gitleaks detected secrets. Remove and re-commit."
  exit "$GITLEAKS_EXIT"
fi

echo "  ✓ gitleaks clean"
echo ""
# ─── Step 7: Capture invariant (Task #44) ───────────────────
# Enforces: no file outside training/capture.service.ts may directly
# call prisma.consultationMessage.create / createMany. This guarantees
# the single-entry-point property of the training data pipeline.
#
# @see docs/adr/0003-training-data-architecture.md Decision 1
# @see apps/api/src/services/training/capture.service.ts
echo "→ Capture invariant check (Task #44)..."

violations=$(grep -rn \
  -E "prisma\.consultationMessage\.(create|createMany)\s*\(" \
  apps/ packages/ \
  --include="*.ts" \
  --include="*.tsx" \
  2>/dev/null \
  | grep -v "apps/api/src/services/training/capture.service.ts" \
  | grep -v "/__tests__/" \
  | grep -v "/\*\*" \
  | grep -v "^\s*//" \
  || true)

if [ -n "$violations" ]; then
  echo ""
  echo "❌ Capture invariant violation: direct prisma.consultationMessage.create call detected."
  echo "   All ConsultationMessage writes MUST route through captureMessage()."
  echo ""
  echo "   Offending lines:"
  echo "$violations" | sed 's/^/     /'
  echo ""
  echo "   Fix: import { captureMessage } from '@/services/training' and call that instead."
  echo "   See docs/adr/0003-training-data-architecture.md Decision 1."
  exit 1
fi

echo "  ✓ Capture invariant intact"
echo "✅ FAANG-grade pre-commit passed — types + lint + secrets verified across full monorepo."
echo ""