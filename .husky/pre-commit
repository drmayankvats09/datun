#!/usr/bin/env sh
# ═══════════════════════════════════════════════════════════════
# PRE-COMMIT HOOK — Defense Layer 1 (Local)
#
# Order of execution (fail-fast):
#   1. lint-staged   → Prettier formats + ESLint validates staged files
#   2. gitleaks      → Scans staged content for secret patterns
#
# Implementation (gitleaks v8.30+ — file-path-aware):
#   We use `gitleaks git --pre-commit --staged` which reads the staging
#   index and PRESERVES file paths in scan results. This is critical
#   because it allows [allowlist].paths in .gitleaks.toml to skip
#   test fixtures (e.g., __tests__/) that contain realistic-looking
#   passwords used as test data.
#
#   STDIN mode (git diff | gitleaks stdin) is INTENTIONALLY NOT USED:
#   it strips file path metadata, making allowlist.paths a no-op. This
#   was a Day 12-13 architectural bug — fixed via this design.
#
# Config:
#   - .gitleaks.toml     (ruleset + path allowlist for test fixtures)
#   - .gitleaksignore    (specific fingerprint exclusions if needed)
#
# Reference:
#   - github.com/gitleaks/gitleaks (v8.19+ command syntax)
#   - github.com/gitleaks/gitleaks/issues/1300 (stdin path stripping)
#
# Emergency bypass (false positives only):
#   git commit --no-verify
#
# Standard: Stripe, Vercel, Linear pre-commit conventions
# ═══════════════════════════════════════════════════════════════

set -e

# ─── Step 1: lint-staged (Prettier + ESLint on staged files) ───
npx lint-staged
LINT_EXIT=$?
if [ "$LINT_EXIT" -ne 0 ]; then
  echo ""
  echo "❌ lint-staged failed. Fix formatting/lint errors before committing."
  exit "$LINT_EXIT"
fi

# ─── Step 2: gitleaks secret scan ──────────────────────────────
if ! command -v gitleaks > /dev/null 2>&1; then
  echo ""
  echo "⚠️  gitleaks not installed — skipping secret scan."
  echo "   Install (Windows): winget install Gitleaks.Gitleaks"
  echo "   Install (macOS):   brew install gitleaks"
  echo "   Install (Linux):   apt install gitleaks  OR  dnf install gitleaks"
  echo ""
  echo "   ⚠️  SECURITY RISK: Commit may contain secrets without scan."
  echo "   Server-side scanning (GitHub + Semgrep CI) will still catch on push."
  exit 0
fi

# Skip if nothing staged (faster, cleaner)
if git diff --cached --quiet; then
  echo "ℹ️  No staged changes to scan."
  exit 0
fi

# File-path-aware staged scan
# `git --pre-commit --staged` reads the staging index, preserving file paths
# so .gitleaks.toml [allowlist].paths can skip test fixtures correctly.
set +e
gitleaks git --pre-commit --staged \
  --redact \
  --no-banner \
  --config=.gitleaks.toml \
  --exit-code 1
GITLEAKS_EXIT=$?
set -e

if [ "$GITLEAKS_EXIT" -ne 0 ]; then
  echo ""
  echo "❌ gitleaks detected secrets in staged changes."
  echo "   Review the findings above carefully."
  echo "   Remove secrets from staged files, then re-commit."
  echo ""
  echo "   If this is a false positive (e.g., test fixture), add to:"
  echo "     - .gitleaks.toml      (allowlist.paths — preferred for whole files/dirs)"
  echo "     - .gitleaksignore     (specific fingerprint — preferred for one-off matches)"
  echo ""
  echo "   Emergency bypass (use ONLY after verifying false positive):"
  echo "     git commit --no-verify"
  exit "$GITLEAKS_EXIT"
fi

echo "✅ Pre-commit checks passed (lint-staged + gitleaks)"