{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Stryker mutation testing — verifies tests catch real bugs (FAANG ship gate)",
  "packageManager": "pnpm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "./vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "prisma/seeds/anonymization/**/*.ts",
    "prisma/seeds/audit-db/**/*.ts",
    "prisma/seeds/multi-tenant/**/*.ts",
    "!**/*.test.ts",
    "!**/*.types.ts",
    "!**/index.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "htmlReporter": {
    "fileName": "tmp/mutation-report.html"
  },
  "jsonReporter": {
    "fileName": "tmp/mutation-report.json"
  }
}
