{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prisma/seeds/wave7": "./prisma/seeds/wave7.ts",
    "./prisma/seeds/wave8": "./prisma/seeds/wave8.ts",
    "./prisma/seeds/wave10": "./prisma/seeds/wave10.ts",
    "./prisma/seeds/wave12": "./prisma/seeds/wave12.ts",
    "./prisma/seeds/anonymization": "./prisma/seeds/anonymization/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seeds/seed.ts",
    "db:studio": "prisma studio",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "db:verify": "tsx src/scripts/verify-migration.ts",
    "db:drift:check": "tsx src/scripts/check-drift.ts",
    "db:rollback:gen": "tsx src/scripts/generate-rollback.ts",
    "db:validate:data": "tsx src/scripts/pre-migration-validate.ts",
    "db:dry-run": "tsx src/scripts/migration-dry-run.ts",
    "db:rollback:simulate": "tsx src/scripts/simulate-rollback.ts",
    "db:changelog:gen": "tsx src/scripts/generate-changelog.ts",
    "db:erd:gen": "tsx src/scripts/generate-erd.ts",
    "db:extensions:audit": "tsx src/scripts/audit-extensions.ts",
    "db:impact:analyze": "tsx src/scripts/impact-analyzer.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:migrations": "vitest run src/__tests__/migrations",
    "test:wave6": "vitest run prisma/seeds/validation",
    "test:wave6:cov": "vitest run prisma/seeds/validation --coverage",
    "probes:run": "tsx prisma/seeds/cli/index.ts probes",
    "probes:db": "tsx prisma/seeds/cli/index.ts probes --names database",
    "bench:run": "tsx prisma/seeds/load-bench/bench-harness.ts",
    "bench:bulk": "tsx prisma/seeds/bulk-loader/copy-vs-createmany.bench.ts",
    "chaos:run": "tsx prisma/seeds/load-bench/chaos-injector.ts",
    "audit:verify": "tsx prisma/seeds/cli/index.ts audit verify",
    "audit:retain": "tsx prisma/seeds/cli/index.ts audit retain",
    "audit:migrate-from-file": "tsx -e \"import('./prisma/seeds/audit-db/migrate-from-file').then(m => m.migrateFileAuditToDb()).then(console.log)\"",
    "drift:detect": "tsx prisma/seeds/cli/index.ts drift",
    "snapshot:diff": "tsx -e \"console.log('Use diffSnapshots(urlA, urlB) programmatically')\"",
    "dr:drill": "tsx prisma/seeds/cli/index.ts dr-drill",
    "compat:check": "vitest run prisma/seeds/compat-matrix",
    "// existing scripts above": "...",
    "test:mutation": "stryker run",
    "test:flake-report": "tsx -e \"import('./prisma/seeds/validation/flake-detector').then(m => console.log(JSON.stringify(m.flakeRegistry.report(), null, 2)))\"",
    "bench:baseline:save": "tsx -e \"import { saveBaseline } from './prisma/seeds/bulk-loader/baseline-comparison'; import data from './tmp/bench-report.json'; saveBaseline({ capturedAt: new Date().toISOString(), gitSha: process.env.GITHUB_SHA, metrics: data.summary })\"",
    "sbom:generate": "cyclonedx-npm --output-format JSON --output-file tmp/sbom.cyclonedx.json",
    "epsilon:validate": "tsx -e \"import { computeEpsilon } from './prisma/seeds/differential-privacy/epsilon-validator'; console.log(JSON.stringify(computeEpsilon(Number(process.argv[2]), Number(process.argv[3])), null, 2))\"",
    "eval:run": "tsx prisma/seeds/cli/index.ts eval run",
    "eval:run:full": "tsx prisma/seeds/cli/index.ts eval run --include-extended",
    "eval:baseline:promote": "tsx prisma/seeds/cli/index.ts eval baseline:promote",
    "synthesize": "tsx prisma/seeds/cli/index.ts synthesize",
    "synthesize:full": "tsx prisma/seeds/cli/index.ts synthesize --strategy persona-vary --per-seed 10 --target-final 1000",
    "training:test": "vitest run prisma/seeds/ai-training",
    "training:lineage:risk": "tsx -e \"import('./prisma/seeds/ai-training/lineage').then(m => new m.LineageStore(prisma).modelCollapseRiskReport()).then(console.log)\"",
    "rlhf:export-dpo": "tsx -e \"import('./prisma/seeds/ai-training/rlhf').then(m => m.exportDpoDataset(prisma, './tmp/datun-dpo.jsonl'))\"",
    "privacy:budget:check": "tsx -e \"import('./prisma/seeds/ai-training/privacy-budget').then(m => new m.BudgetAccumulator(prisma).getUsage('global')).then(console.log)\"",
    "outbox:status": "tsx prisma/seeds/outbox/outbox-cli.ts status",
    "outbox:list": "tsx prisma/seeds/outbox/outbox-cli.ts list",
    "outbox:show": "tsx prisma/seeds/outbox/outbox-cli.ts show",
    "outbox:replay-dlq": "tsx prisma/seeds/outbox/outbox-cli.ts replay-dlq",
    "outbox:cleanup": "tsx prisma/seeds/outbox/outbox-cli.ts cleanup",
    "outbox:stuck": "tsx prisma/seeds/outbox/outbox-cli.ts stuck",
    "drift:detect:training": "tsx prisma/seeds/continuous-training/drift/drift-cli.ts detect",
    "drift:list": "tsx prisma/seeds/continuous-training/drift/drift-cli.ts list",
    "drift:show": "tsx prisma/seeds/continuous-training/drift/drift-cli.ts show",
    "drift:ack": "tsx prisma/seeds/continuous-training/drift/drift-cli.ts ack",
    "drift:stats": "tsx prisma/seeds/continuous-training/drift/drift-cli.ts stats",
    "prompt:list": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts list",
    "prompt:show": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts show",
    "prompt:create": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts create",
    "prompt:activate": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts activate",
    "prompt:rollout-plan": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts rollout-plan",
    "prompt:rollout-advance": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts rollout-advance",
    "prompt:rollback": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts rollback",
    "prompt:diff": "tsx prisma/seeds/continuous-training/prompts/prompt-cli.ts diff",
    "db:seed:matrix": "tsx prisma/seeds/cli/index.ts seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@mongodb-js/zstd": "^2.0.0",
    "@prisma/client": "^6.8.2",
    "@sentry/node": "^10.50.0",
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.3",
    "ioredis": "^5.10.1",
    "pg": "8.13.1",
    "pg-boss": "^12.18.2",
    "pg-copy-streams": "^7.0.0",
    "prisma": "^6.8.2",
    "prom-client": "15.1.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@faker-js/faker": "^9.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@prisma/internals": "6.19.3",
    "@repo/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.19.17",
    "@types/pg": "8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "2.1.4",
    "fast-check": "^4.7.0",
    "testcontainers": "^11.0.0",
    "tinybench": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.2",
    "vitest": "2.1.4"
  }
}
