// ═══════════════════════════════════════════════════════════════
// TRAINING DATA ENUMS — Task #44 (LLM training pipeline)
// LabelerTier: who produced this label (human, AI judge, or crowd)
// JudgeRunStatus: lifecycle of an LLM-as-judge grading attempt
// DataAssetKind: what kind of training asset this version represents
// ═══════════════════════════════════════════════════════════════

enum LabelerTier {
  HUMAN_EXPERT // Mayank / future BDS doctors — ground truth
  LLM_JUDGE // Claude Haiku auto-grading — scale tier
  CROWD // Future: paid annotators (Scale AI / internal) — Month 12+
}

enum JudgeRunStatus {
  PENDING // Queued, not yet run
  RUNNING // Currently in flight (worker holding lock)
  SUCCESS // Completed, score persisted
  FAILED // Errored — see errorMessage
  SKIPPED // Eligibility gate rejected (e.g., no consent)
}

enum DataAssetKind {
  TRAINING_EXAMPLES // Supervised fine-tune dataset (JSONL)
  PREFERENCE_PAIRS // DPO/RLHF preference pairs
  EVAL_SET // Held-out evaluation suite (never trained on)
  FINE_TUNE_INPUT // Combined SFT+DPO bundle for a specific run
  RAG_INDEX // Vector chunks for retrieval (Month 5 RAG)
}

