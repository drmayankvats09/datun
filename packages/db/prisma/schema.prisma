// ═══════════════════════════════════════════════════════════════
// TABLE 31: JobLog
// Background job execution audit trail (Task #41 — BullMQ)
// Every BullMQ job execution → row in this table.
// Pattern: Stripe webhook deliveries + Linear job audit.
// Used for: failure analysis, retry decisions, future ML training data (Task #44).
// ═══════════════════════════════════════════════════════════════

model JobLog {
  id             String        @id @default(uuid()) @db.Uuid
  queueName      String // "whatsapp", "email", "pdf", "scheduled"
  jobName        String // Specific job type within queue
  jobId          String        @unique // BullMQ job ID (idempotency key)
  status         JobStatus     @default(QUEUED)
