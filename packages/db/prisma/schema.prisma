// ═══════════════════════════════════════════════════════════════
// DATUN — Complete Database Schema v1
// 31 Tables | 300+ Fields | 5-Year Architecture
// Built for 1,00,000+ users Day 1
// Author: Dr. Mayank Vats (CEO) + CTO Architecture
// ═══════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────
// PRISMA CLIENT GENERATOR
// ─────────────────────────────────────────────────────────────────────────
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

// ─────────────────────────────────────────────────────────────────────────
// DATASOURCE — PostgreSQL with shadow database for migration validation
// ─────────────────────────────────────────────────────────────────────────
//
// shadowDatabaseUrl is REQUIRED for `prisma migrate dev` workflow.
// Prisma uses this database to:
//   1. Apply existing migrations and check for drift
//   2. Validate new migrations against current schema
//   3. Detect schema reset issues
//
// Production deployments use `prisma migrate deploy` which does NOT need
// shadowDatabaseUrl — only `migrate dev` (local development) requires it.
//
// Local: Native Postgres on Windows (postgresql://localhost:5432/datun_shadow)
// CI: GitHub Actions Postgres service container (ephemeral)
// Production: NOT applicable (uses migrate deploy only)
//
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

