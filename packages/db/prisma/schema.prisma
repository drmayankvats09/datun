// ═══════════════════════════════════════════════════════════════
// TABLE 1: User
// Every person on the platform — patient, clinic owner, admin.
// Central identity table. All other tables reference this.
// ═══════════════════════════════════════════════════════════════

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  phone        String? @unique
  passwordHash String?
  name         String  @default("")
  avatarUrl    String?

  // ── Wave 3 v2 denormalized fields (factory-friendly) ──
  firstName          String?
  lastName           String?
  fullName           String?
  role               UserPrimaryRole? // mirror of primaryRole; @deprecated, use primaryRole
  googleId           String?          @unique
  appleId            String?          @unique
  dateOfBirth        DateTime?
  gender             Gender?
  languagePreference String           @default("en")
  city               String?
  state              String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  primaryRole        UserPrimaryRole  @default(PATIENT)
  isEmailVerified    Boolean          @default(false)
  isPhoneVerified    Boolean          @default(false)
  isActive           Boolean          @default(true)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginDevice    String?
  referralCode       String?          @unique
  referredById       String?          @db.Uuid
  referredBy         User?            @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]           @relation("UserReferrals")
  subscriptionTier   SubscriptionTier @default(FREE)
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  // ── Relations ──
  patient                  Patient?
  roles                    UserRole[]
  authIdentities           UserAuthIdentity[]
  clinicsOwned             Clinic[]
  clinicMemberships        ClinicMember[]
  clinicInvitesSent        ClinicInvitation[]       @relation("InvitedByUser")
  doctor                   Doctor?
  consultations            Consultation[]           @relation("UserConsultations")
  consultationsStarted     Consultation[]           @relation("InitiatedByUser")
  appointments             Appointment[]            @relation("PatientAppointments")
  prescriptions            Prescription[]           @relation("UserPrescriptions")
  reviewsGiven             Review[]
  leadsAsPatient           Lead[]                   @relation("PatientLeads")
  notifications            Notification[]
  notificationPrefs        NotificationPreference[]
  whatsappMessages         WhatsAppMessage[]
  auditLogs                AuditLog[]
  consentLogs              ConsentLog[]
  emailLogs                EmailLog[]
  mediaUploads             MediaAsset[]             @relation("UploadedByUser")
  trainingLabels           TrainingLabel[]
  patientAccesses          UserPatientAccess[]      @relation("UserAccesses")
  jobLogs                  JobLog[]
  dataAssetVersions        DataAssetVersion[]
  dataAssetVersionsCreated DataAssetVersion[]       @relation("DataAssetVersionCreator")

  @@index([email])
  @@index([phone])
  @@index([createdAt(sort: Desc)])
  @@index([primaryRole])
  @@index([referralCode])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 2: Patient
// Medical data separated from User for security.
// Doctor needs allergies but NOT login IP. Separation of concerns.
// ═══════════════════════════════════════════════════════════════

model Patient {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── B-1 v2: Denormalized identity (FAANG perf — eliminate User join on patient queries) ──
  firstName       String?
  lastName        String?
  fullName        String?
  dateOfBirth     DateTime?
  ageYears        Int?
  gender          Gender?
  phone           String?
  email           String?
  preferredLocale LocaleCode @default(en)

  // ── B-1 v2: NMC patient identity verification ──
  verifiedNameAt   DateTime?
  kycLevel         KycLevel  @default(NONE)
  governmentIdHash String?
  abhaId           String?

  // ── B-1 v2: Tenant scoping (clinic = tenant in Datun model) ──
  clinicId String? @db.Uuid
  clinic   Clinic? @relation("PatientHomeClinic", fields: [clinicId], references: [id])

  // ── Existing medical fields ──
  bloodGroup            String?
  allergies             Json?
  knownAllergies        Json?
  medicalConditions     Json?
  currentMedications    Json?
  emergencyContactName  String?
  emergencyContactPhone String?
  dentalHistory         Json?
  lastDentalVisit       DateTime?
  smokingStatus         SmokingStatus?
  tobaccoUse            Boolean?
  alcoholUse            Boolean?
  pregnancyStatus       PregnancyStatus?
  insuranceProvider     String?
  insurancePolicyNumber String?

  // ── B-1 v2: Archetype-driven demographic context ──
  primaryConditionIcd10   String?
  comorbidConditionsIcd10 String[]
  sesTier                 String?
  residence               String?
  educationLevel          String?
  insuranceId             String?
  referralChannel         String?
  safetyConstraints       String[]
  archetypeKey            String?

  // ── DPDP retention tracking ──
  consentVersion       String?
  lastConsentRenewedAt DateTime?
  retentionUntil       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accessedBy    UserPatientAccess[]
  consultations Consultation[]
  appointments  Appointment[]
  prescriptions Prescription[]
  reviews       Review[]
  leads         Lead[]

  @@index([clinicId])
  @@index([fullName])
  @@index([phone])
  @@index([primaryConditionIcd10])
  @@index([archetypeKey])
  @@index([kycLevel])
  @@index([deletedAt])
  @@map("patients")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 3: UserPatientAccess
// Parent books for child, husband for wife, caregiver for elder.
// India mein healthcare = family affair. Day 1 se chahiye.
// ═══════════════════════════════════════════════════════════════

model UserPatientAccess {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  user         User                @relation("UserAccesses", fields: [userId], references: [id], onDelete: Cascade)
  patientId    String              @db.Uuid
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relationship PatientRelationship
  accessLevel  AccessLevel         @default(FULL)
  isPrimary    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, patientId])
  @@index([userId])
  @@index([patientId])
  @@map("user_patient_accesses")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 4: UserRole
// One person = multiple roles. Doctor + patient + clinic owner.
// Proper RBAC table — Google Workspace / AWS IAM standard.
// ═══════════════════════════════════════════════════════════════

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleType
  clinicId  String?  @db.Uuid
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, role, clinicId])
  @@index([userId])
  @@map("user_roles")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 5: UserAuthIdentity
// Auth0 today, own auth tomorrow, Apple/Google/OTP later.
// Each login method = separate row. Migration-proof.
// ═══════════════════════════════════════════════════════════════

model UserAuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerUserId  String
  emailAtProvider String?
  phoneAtProvider String?
  isPrimary       Boolean      @default(false)
  linkedAt        DateTime     @default(now())
  lastUsedAt      DateTime?

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_auth_identities")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 6: Clinic
// B2B side — dental clinic profiles. "Zomato of healthcare"
// mein restaurants ki jagah clinics.
// ═══════════════════════════════════════════════════════════════

model Clinic {
  id                  String     @id @default(uuid()) @db.Uuid
  ownerId             String     @db.Uuid
  owner               User       @relation(fields: [ownerId], references: [id])
  name                String
  slug                String     @unique
  description         String?    @db.Text
  phone               String
  email               String
  website             String?
  address             String
  landmark            String?
  city                String
  state               String
  pincode             String
  latitude            Float
  longitude           Float
  registrationNumber  String?
  registrationCertUrl String?
  isVerified          Boolean    @default(false)
  tier                ClinicTier @default(LITE) // Derived from Subscription — Subscription is source of truth
  trialEndsAt         DateTime?
  logoUrl             String?
  coverImageUrl       String?
  photos              Json?
  services            Json?
  specialties         Json?
  languages           Json?
  openingHours        Json?
  averageRating       Float      @default(0)
  totalReviews        Int        @default(0)
  totalLeads          Int        @default(0)
  totalAppointments   Int        @default(0)
  isActive            Boolean    @default(true)
  onboardingStep      Int        @default(0)
  // ── B-1 v2: Service capabilities ──
  acceptsEmergencies  Boolean    @default(false)
  acceptsInsurance    Boolean    @default(false)
  acceptsTelemedicine Boolean    @default(true)
  timezone            String     @default("Asia/Kolkata")
  primaryLocale       LocaleCode @default(en)

  // ── B-1 v2: Subscription denormalization (mirrors Subscription source-of-truth) ──
  subscriptionTier      SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?

  // ── B-1 v2: DPDP compliance ──
  complianceProfile ComplianceProfile @default(DPDP_INDIA)
  dataRetentionDays Int               @default(2555) // ~7 years (DPDP minimum for medical)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  // ── Relations ──
  // ── B-1 v2: New back-relations ──
  homePatients   Patient[]          @relation("PatientHomeClinic")
  consultations  Consultation[]     @relation("ConsultationClinic")
  primaryDoctors Doctor[]           @relation("DoctorPrimaryClinic")
  members        ClinicMember[]
  invitations    ClinicInvitation[]
  doctors        DoctorClinic[]
  appointments   Appointment[]
  reviews        Review[]
  leads          Lead[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  userRoles      UserRole[]

  @@index([slug])
  @@index([city])
  @@index([ownerId])
  @@index([isActive, isVerified])
  @@map("clinics")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 7: ClinicMember
// Staff in a clinic — owner, receptionist, associate doctor.
// Many-to-many between Clinic and User with role context.
// ═══════════════════════════════════════════════════════════════

model ClinicMember {
  id          String           @id @default(uuid()) @db.Uuid
  clinicId    String           @db.Uuid
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ClinicMemberRole
  isActive    Boolean          @default(true)
  invitedAt   DateTime         @default(now())
  joinedAt    DateTime?
  invitedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // ── Relations ──
  leadsAssigned Lead[]

  @@unique([clinicId, userId])
  @@index([clinicId])
  @@index([userId])
  @@map("clinic_members")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 8: ClinicInvitation
// Owner invites staff by email/phone BEFORE they sign up.
// Staff joins → auto-linked to clinic via token.
// ═══════════════════════════════════════════════════════════════

model ClinicInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  clinicId     String           @db.Uuid
  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  emailOrPhone String
  role         ClinicMemberRole
  invitedById  String           @db.Uuid
  invitedBy    User             @relation("InvitedByUser", fields: [invitedById], references: [id])
  tokenHash    String           @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clinicId])
  @@index([emailOrPhone])
  @@index([tokenHash])
  @@map("clinic_invitations")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 9: Doctor
// Doctor-specific profile — credentials, specialties, fees.
// Separate from User because doctor fields are domain-specific.
// ═══════════════════════════════════════════════════════════════

model Doctor {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── B-1 v2: NMC mandatory fields ──
  registrationNumber     String
  registrationCouncil    String?
  registrationState      String?
  registrationVerifiedAt DateTime?

  // ── Identity denormalization ──
  title     String? @default("Dr.")
  firstName String?
  lastName  String?

  // ── Qualification ──
  qualifications  String
  degree          String?
  specialization  String?
  yearsExperience Int?

  // ── Profile ──
  bio                 String? @db.Text
  avatarUrl           String?
  isAcceptingPatients Boolean @default(true)
  acceptsEmergencies  Boolean @default(false)
  acceptsTelemedicine Boolean @default(true)
  rating              Float   @default(0)
  totalConsultations  Int     @default(0)

  // ── B-1 v2: Primary clinic ──
  clinicId String? @db.Uuid
  clinic   Clinic? @relation("DoctorPrimaryClinic", fields: [clinicId], references: [id])

  // ── Languages spoken (for patient matching) ──
  languagesSpoken LocaleCode[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clinics               DoctorClinic[]
  appointments          Appointment[]
  reviews               Review[]
  consultationsReviewed Consultation[] @relation("ReviewedByDoctor")
  consultations         Consultation[] @relation("ConsultationDoctor")
  prescriptionsSigned   Prescription[] @relation("SignedByDoctor")
  prescriptionsReviewed Prescription[] @relation("ReviewedByDoctor")

  @@index([clinicId])
  @@index([isAcceptingPatients])
  @@index([acceptsEmergencies])
  @@index([deletedAt])
  @@index([registrationNumber])
  @@map("doctors")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 10: DoctorClinic
// Doctor practices at multiple clinics — morning ek, evening doosri.
// Replaces Doctor.clinicId for proper many-to-many.
// ═══════════════════════════════════════════════════════════════

model DoctorClinic {
  id                   String    @id @default(uuid()) @db.Uuid
  doctorId             String    @db.Uuid
  doctor               Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId             String    @db.Uuid
  clinic               Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  isPrimaryClinic      Boolean   @default(false)
  consultationFeePaisa Int?
  isActive             Boolean   @default(true)
  startDate            DateTime  @default(now())
  endDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([doctorId, clinicId])
  @@index([doctorId])
  @@index([clinicId])
  @@map("doctor_clinics")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 11: Consultation
// CORE TABLE — AI dental consultation. Patient ↔ AI interaction.
// Every diagnosis, every medication, every PDF lives here.
// ═══════════════════════════════════════════════════════════════

model Consultation {
  id                         String             @id @default(uuid()) @db.Uuid
  patientId                  String             @db.Uuid
  patient                    Patient            @relation(fields: [patientId], references: [id])
  initiatedByUserId          String             @db.Uuid
  initiatedByUser            User               @relation("InitiatedByUser", fields: [initiatedByUserId], references: [id])
  userId                     String             @db.Uuid
  user                       User               @relation("UserConsultations", fields: [userId], references: [id])
  clientUuid                 String?            @unique
  status                     ConsultationStatus @default(IN_PROGRESS)
  language                   String             @default("en")
  chiefComplaint             String?            @db.Text
  diagnosis                  String?            @db.Text
  urgency                    UrgencyLevel?
  treatmentPlan              String?            @db.Text
  homeRemedies               String?            @db.Text
  dosList                    Json?
  dontsList                  Json?
  redFlags                   Json?
  medications                Json?
  investigationsNeeded       Json?
  visualFindings             String?            @db.Text
  photoUrls                  Json?
  followUpDays               Int?
  // ── AI tracking ──
  aiProvider                 String             @default("claude")
  aiModel                    String?
  aiLatencyMs                Int?
  aiTokensUsed               Int?
  aiCostUsd                  Decimal?           @db.Decimal(10, 6)
  promptVersion              String?
  workflowVersion            String?
  safetyFlags                Json?
  // ── Human review (proprietary AI path) ──
  needsHumanReview           Boolean            @default(false)
  reviewStatus               ReviewStatusEnum?
  reviewedByDoctorId         String?            @db.Uuid
  reviewedByDoctor           Doctor?            @relation("ReviewedByDoctor", fields: [reviewedByDoctorId], references: [id])
  reviewedAt                 DateTime?
  reviewNotes                String?            @db.Text
  // ── Stats ──
  totalMessages              Int                @default(0)
  durationSeconds            Int?
  // ── PDF ──
  pdfUrl                     String?
  pdfGeneratedAt             DateTime?
  shareableSlug              String?            @unique
  shareableLinkExpiresAt     DateTime?
  // ── Compliance ──
  consentGiven               Boolean            @default(false)
  consentAt                  DateTime?
  // ── Task #44: DATA_TRAINING consent (separate from treatment consent — DPDP requirement) ──
  dataTrainingConsentAt      DateTime?
  dataTrainingConsentVersion String? // semver of the consent notice text the patient agreed to
  // ── Source ──
  sourceChannel              SourceChannel      @default(WEB)
  leadId                     String?            @db.Uuid
  lead                       Lead?              @relation(fields: [leadId], references: [id])
  // ── B-1 v2: Doctor assignment (separate from review) ──
  doctorId                   String?            @db.Uuid
  doctor                     Doctor?            @relation("ConsultationDoctor", fields: [doctorId], references: [id])

  // ── B-1.6: Final diagnosis ICD-10 (separate from chief-complaint icd10Code) ──
  primaryDiagnosisIcd10 String?

  // ── B-1 v2: Tenant scoping ──
  clinicId String? @db.Uuid
  clinic   Clinic? @relation("ConsultationClinic", fields: [clinicId], references: [id])

  // ── B-1 v2: NMC compliance ──
  ageVerifiedAt         DateTime?
  ageVerifiedMethod     String?
  consentVersion        String?
  isAiOnly              Boolean   @default(true)
  requiresPhysicalVisit Boolean   @default(false)

  // ── B-1 v2: ICD-10 diagnosis (separate from free-text) ──
  icd10Code        String?
  icd10ChapterCode String?

  // ── B-1 v2: Patient context snapshot at consultation ──
  patientAge             Int?
  patientGender          Gender?
  patientPregnancyStatus PregnancyStatus?
  severity               UrgencyLevel?
  chiefComplaintLocale   LocaleCode?

  // ── B-1 v2: AI provider tracking enhancement ──
  fallbackProviderUsed String?
  aiCircuitBreakerHits Int       @default(0)
  metadata             Json?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // ── Relations ──
  messages         ConsultationMessage[]
  trainingLabels   TrainingLabel[]
  appointments     Appointment[]
  prescription     Prescription?
  whatsappMessages WhatsAppMessage[]
  emailLogs        EmailLog[]
  jobLogs          JobLog[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([patientId])
  @@index([createdAt(sort: Desc)])
  @@index([shareableSlug])
  @@map("consultations")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 12: ConsultationMessage
// Every single message — patient said what, AI replied what.
// Training data ka backbone. 10k labeled = LoRA fine-tune ready.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// TABLE 12: ConsultationMessage — Task #44 expanded
// Every single message — patient said what, AI replied what.
// Training data backbone. 10k labeled = LoRA fine-tune ready.
// Per-message AI metadata for granular cost + lineage tracking.
// ═══════════════════════════════════════════════════════════════

model ConsultationMessage {
  id             String             @id @default(uuid()) @db.Uuid
  consultationId String             @db.Uuid
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String             @db.Text
  contentType    MessageContentType @default(TEXT)
  imageUrl       String?
  chips          Json?
  selectedChip   String?
  sequenceNumber Int

  // ── Task #44: Per-message AI metadata (granular cost + lineage) ──
  aiProvider     String? // "claude" | "openai" | "gemini" — which provider answered
  aiModel        String? // "claude-opus-4-7" | "gpt-5.5" | "gemini-2.5-pro"
  aiLatencyMs    Int?
  aiTokensInput  Int? // tokens consumed in prompt
  aiTokensOutput Int? // tokens generated in response
  aiCostUsd      Decimal? @db.Decimal(10, 6)
  promptVersion  String? // links to versioned prompt registry

  // ── Task #44: Privacy + lineage ──
  redactedContent     Json? // { text, piiCategories[], maskCount, redactionVersion }
  piiRedactionVersion String? // semver of redaction ruleset applied
  correlationId       String? // request-id middleware nanoid — Sentry + Winston + DB trace

  // ── Task #44: LLM-as-judge tier ──
  judgeScore     Float? // 1.0-5.0 from Claude Haiku auto-grader
  judgeReasoning String?    @db.Text
  judgeRunId     String? // FK to JudgeRun (the run that produced this score)
  judgeRun       JudgeRun?  @relation(fields: [judgeRunId], references: [id])
  judgeRuns      JudgeRun[] @relation("AllJudgeRunsForMessage")

  // ── Task #44: Future RAG (Task #132 — Month 5 reserved column) ──
  embeddingId String? // pgvector embedding ID — populated by Task #132

  // ── Task #44: Export lineage (Month 6 export pipeline — reserved) ──
  exportedToTrainingAt DateTime?
  exportBatchId        String?

  createdAt DateTime @default(now())

  // ── Relations ──
  trainingLabels TrainingLabel[]

  @@index([consultationId, sequenceNumber])
  @@index([role, judgeScore]) // active learning queue lookup
  @@index([exportedToTrainingAt]) // export pipeline scan
  @@index([correlationId]) // debugging trace lookup
  @@index([judgeScore, createdAt(sort: Desc)]) // margin-strategy active learning
  @@map("consultation_messages")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 13: TrainingLabel
// Mayank rates AI responses 1-5, writes corrections.
// 10,000 quality-labeled records = proprietary AI moat.
// ═══════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════
// TABLE 13: TrainingLabel — Task #44 expanded
// Mayank (or LLM judge, or future crowd) rates AI responses 1-5.
// Multi-tier label system: HUMAN_EXPERT > LLM_JUDGE > CROWD.
// Inter-rater agreement tracked for quality assurance.
// ═══════════════════════════════════════════════════════════════

model TrainingLabel {
  id             String               @id @default(uuid()) @db.Uuid
  consultationId String               @db.Uuid
  consultation   Consultation         @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  messageId      String?              @db.Uuid
  message        ConsultationMessage? @relation(fields: [messageId], references: [id])
  labeledById    String               @db.Uuid
  labeledBy      User                 @relation(fields: [labeledById], references: [id])
  qualityScore   Int // 1-5 (CHECK constraint via migration)
  isCorrect      Boolean
  correctionText String?              @db.Text
  clinicalNotes  String?              @db.Text
  category       String?

  // ── Task #44: Multi-tier labeling ──
  tier                LabelerTier @default(HUMAN_EXPERT)
  agreementScore      Float? // Cohen's Kappa or simple agreement (0-1) when 2+ labelers exist
  disputedWithLabelId String?     @db.Uuid // UUID of the opposing label if disagreement detected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultationId])
  @@index([labeledById])
  @@index([tier, qualityScore]) // tier-stratified analytics
  @@index([messageId, tier]) // judge-vs-human comparison lookup
  @@map("training_labels")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 14: Appointment
// Patient books appointment at a clinic.
// Full lifecycle: scheduled → confirmed → check-in → completed.
// ═══════════════════════════════════════════════════════════════

model Appointment {
  id                   String            @id @default(uuid()) @db.Uuid
  patientId            String            @db.Uuid
  patient              Patient           @relation(fields: [patientId], references: [id])
  userId               String            @db.Uuid
  user                 User              @relation("PatientAppointments", fields: [userId], references: [id])
  clinicId             String            @db.Uuid
  clinic               Clinic            @relation(fields: [clinicId], references: [id])
  doctorId             String?           @db.Uuid
  doctor               Doctor?           @relation(fields: [doctorId], references: [id])
  consultationId       String?           @db.Uuid
  consultation         Consultation?     @relation(fields: [consultationId], references: [id])
  leadId               String?           @db.Uuid
  lead                 Lead?             @relation(fields: [leadId], references: [id])
  scheduledAt          DateTime
  durationMinutes      Int               @default(30)
  timezone             String            @default("Asia/Kolkata")
  status               AppointmentStatus @default(SCHEDULED)
  type                 AppointmentType   @default(FIRST_VISIT)
  chiefComplaint       String?           @db.Text
  urgency              UrgencyLevel?
  notes                String?           @db.Text
  cancelledAt          DateTime?
  cancelledById        String?           @db.Uuid
  cancellationReason   String?           @db.Text
  reminderSentAt       DateTime?
  confirmedAt          DateTime?
  checkInAt            DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  completedAt          DateTime?
  rescheduledFromId    String?           @db.Uuid
  rescheduledFrom      Appointment?      @relation("Reschedules", fields: [rescheduledFromId], references: [id])
  rescheduledTo        Appointment[]     @relation("Reschedules")
  patientFeedbackScore Int?
  amountPaisa          Int?
  paymentStatus        PaymentStatus?
  sourceChannel        AppointmentSource @default(DATUN_AI)
  metadata             Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // ── Relations ──
  review              Review?
  paymentTransactions PaymentTransaction[]

  @@index([patientId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 15: Prescription
// AI-generated prescription — structured PDF data.
// signedByDoctorId for multi-doctor flow (future).
// ═══════════════════════════════════════════════════════════════

model Prescription {
  id                            String            @id @default(uuid()) @db.Uuid
  consultationId                String            @unique @db.Uuid
  consultation                  Consultation      @relation(fields: [consultationId], references: [id])
  patientId                     String            @db.Uuid
  patient                       Patient           @relation(fields: [patientId], references: [id])
  userId                        String            @db.Uuid
  user                          User              @relation("UserPrescriptions", fields: [userId], references: [id])
  prescribedByName              String            @default("Dr. Mayank Vats")
  signedByDoctorId              String?           @db.Uuid
  signedByDoctor                Doctor?           @relation("SignedByDoctor", fields: [signedByDoctorId], references: [id])
  diagnosis                     String            @db.Text
  medications                   Json
  investigations                Json?
  procedures                    Json?
  homeRemedies                  Json?
  followUpDate                  DateTime?
  specialInstructions           String?           @db.Text
  pdfUrl                        String?
  pdfVersion                    Int               @default(1)
  shareableSlug                 String?           @unique
  expiresAt                     DateTime?
  viewCount                     Int               @default(0)
  isActive                      Boolean           @default(true)
  // ── Review ──
  reviewStatus                  ReviewStatusEnum?
  reviewedByDoctorId            String?           @db.Uuid
  reviewedByDoctor              Doctor?           @relation("ReviewedByDoctor", fields: [reviewedByDoctorId], references: [id])
  reviewedAt                    DateTime?
  signatureUrl                  String?
  // ── B-1 v2: NMC mandatory prescriber details ──
  prescriberRegistrationNumber  String
  prescriberRegistrationCouncil String?
  prescriberSpecialization      String?

  // ── B-1 v2: Safety check audit trail ──
  pregnancyChecked       Boolean @default(false)
  allergiesChecked       Boolean @default(false)
  bloodThinnerChecked    Boolean @default(false)
  pediatricDosingApplied Boolean @default(false)
  interactionsChecked    Boolean @default(false)

  // ── B-1 v2: Line item denormalization ──
  lineItemCount Int @default(0)

  // ── B-1 v2: Telemedicine eligibility ──
  isTelemedicinePrescription      Boolean @default(false)
  physicalConsultationRecommended Boolean @default(false)

  // ── B-1 v2: Relations ──
  lineItems PrescriptionLineItem[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([patientId])
  @@index([shareableSlug])
  @@map("prescriptions")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 16: Review
// Patient reviews clinic/doctor. Practo's moat = reviews.
// Verified reviews = trust. helpfulCount = engagement.
// ═══════════════════════════════════════════════════════════════

model Review {
  id                String       @id @default(uuid()) @db.Uuid
  patientId         String       @db.Uuid
  patient           Patient      @relation(fields: [patientId], references: [id])
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id])
  clinicId          String       @db.Uuid
  clinic            Clinic       @relation(fields: [clinicId], references: [id])
  doctorId          String?      @db.Uuid
  doctor            Doctor?      @relation(fields: [doctorId], references: [id])
  appointmentId     String?      @unique @db.Uuid
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  overallRating     Int
  cleanlinessRating Int?
  staffRating       Int?
  doctorRating      Int?
  waitTimeRating    Int?
  valueRating       Int?
  reviewText        String?      @db.Text
  clinicResponse    String?      @db.Text
  clinicRespondedAt DateTime?
  isVerified        Boolean      @default(false)
  isPublished       Boolean      @default(true)
  isFlagged         Boolean      @default(false)
  flagReason        String?
  helpfulCount      Int          @default(0)
  source            ReviewSource @default(ORGANIC)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([clinicId, isPublished])
  @@index([patientId])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 17: Lead
// AI consultation → nearby clinic connection. REVENUE CORE.
// Clinic pays for leads. CRM fields for follow-up tracking.
// ═══════════════════════════════════════════════════════════════

model Lead {
  id                  String               @id @default(uuid()) @db.Uuid
  patientId           String               @db.Uuid
  patient             Patient              @relation(fields: [patientId], references: [id])
  userId              String               @db.Uuid
  user                User                 @relation("PatientLeads", fields: [userId], references: [id])
  clinicId            String               @db.Uuid
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  status              LeadStatus           @default(NEW)
  urgency             UrgencyLevel?
  diagnosis           String?              @db.Text
  patientName         String
  patientPhone        String?
  patientArea         String?
  distanceKm          Float?
  // ── CRM fields ──
  assignedToMemberId  String?              @db.Uuid
  assignedToMember    ClinicMember?        @relation(fields: [assignedToMemberId], references: [id])
  firstResponseAt     DateTime?
  lastContactAt       DateTime?
  nextFollowUpAt      DateTime?
  followUpCount       Int                  @default(0)
  lostReasonCode      String?
  // ── Lifecycle ──
  contactedAt         DateTime?
  appointmentBookedAt DateTime?
  convertedAt         DateTime?
  closedAt            DateTime?
  closedReason        String?
  notes               String?              @db.Text
  notifiedVia         NotificationChannel?
  notifiedAt          DateTime?
  revenue             Int?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // ── Relations ──
  consultations Consultation[]
  appointments  Appointment[]
  activities    LeadActivity[]

  @@index([clinicId, status])
  @@index([patientId])
  @@index([nextFollowUpAt])
  @@map("leads")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 18: LeadActivity
// Every touchpoint logged — called, emailed, no answer.
// Real CRM = activity history. Churn prediction data.
// ═══════════════════════════════════════════════════════════════

model LeadActivity {
  id            String               @id @default(uuid()) @db.Uuid
  leadId        String               @db.Uuid
  lead          Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action        String
  notes         String?              @db.Text
  performedById String?              @db.Uuid
  channel       NotificationChannel?
  metadata      Json?
  createdAt     DateTime             @default(now())

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 19: Subscription
// Clinic's paid plan. Source of truth for billing.
// Clinic.tier is DERIVED from this — never edit tier directly.
// ═══════════════════════════════════════════════════════════════

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  clinicId               String             @db.Uuid
  clinic                 Clinic             @relation(fields: [clinicId], references: [id])
  plan                   ClinicTier
  status                 SubscriptionStatus @default(TRIAL)
  billingCycle           BillingCycle       @default(MONTHLY)
  amountPaisa            Int
  currency               String             @default("INR")
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  razorpaySubscriptionId String?
  razorpayCustomerId     String?
  stripeFallbackId       String?
  cancelledAt            DateTime?
  cancellationReason     String?            @db.Text
  pausedAt               DateTime?
  resumesAt              DateTime?
  dunningAttempts        Int                @default(0)
  lastDunningAt          DateTime?
  seatLimit              Int
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  // ── Relations ──
  invoices Invoice[]

  @@index([clinicId])
  @@index([status])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════
// TABLE 20: Invoice
// GST-compliant invoice. Immutable buyer snapshot = legal proof.
// buyerName/address frozen at invoice time — never changes.
// ═══════════════════════════════════════════════════════════════

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  subscriptionId     String        @db.Uuid
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id])
  clinicId           String        @db.Uuid
