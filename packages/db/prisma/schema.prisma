  rampStepPct       Int           @default(20)
  rampIntervalHours Int           @default(24)
  currentTrafficPct Int           @default(0)
  status            String        @default("draft")
  rollbackReason    String?       @db.Text
  startedAt         DateTime?
  completedAt       DateTime?

  @@map("prompt_rollout_plan")
}

model ShadowComparison {
  id                 String    @id
  prompt             String    @db.Text
  productionResponse String    @db.Text
  candidateResponse  String    @db.Text
  productionModel    String
  candidateModel     String
  compositeDelta     Float
  safetyDelta        Float
  latencyDelta       Int
  recommendedAction  String
  comparedAt         DateTime
  reviewedAt         DateTime?
  reviewedBy         String?

  @@index([candidateModel, comparedAt])
  @@index([recommendedAction])
  @@map("shadow_comparison")
}

// ═══════════════════════════════════════════════════════════════
// PHASE B-1 v2: NEW MODELS — Research-backed reference data
// ═══════════════════════════════════════════════════════════════

/// Catalog of medication salts (200+ from Indian Pharmacopoeia 2022 + CDSCO).
/// FAANG-grade with NMC telemedicine compliance + WHO ATC classification.
/// Source: Indian Pharmacopoeia 2022, CDSCO approved drugs, WHO ATC/DDD Index
model MedicationSalt {
  id String @id @default(uuid()) @db.Uuid

  // ── Identity ──
  name           String  @unique
  genericName    String
  brandNames     Json?
  atcCode        String?
  ipMonographRef String?
  nameLocalized  Json?

  // ── Classification ──
  category       MedicationCategory
  subcategory    String?
  schedule       DrugSchedule       @default(NONE)
  isScheduleX    Boolean            @default(false)
  isNarcotic     Boolean            @default(false)
  isPsychotropic Boolean            @default(false)
  isOTC          Boolean            @default(false)

  // ── Telemedicine eligibility (NMC compliance) ──
  isTelemedicineEligible   Boolean @default(true)
  telemedicineRestrictions Json?

  // ── Dosing ──
  dosageForms       Json
  defaultDosageMg   Decimal? @db.Decimal(10, 4)
  maxDailyDoseMg    Decimal? @db.Decimal(10, 4)
  pediatricDosing   Json?
  geriatricDosing   Json?
  renalAdjustment   Json?
  hepaticAdjustment Json?

  // ── Safety ──
  pregnancyCategory PregnancyCategory @default(UNKNOWN)
  lactationCategory String?
  contraindications Json?
  sideEffects       Json?
  blackBoxWarnings  Json?
  indications       Json?

  // ── Status ──
  isActive          Boolean   @default(true)
  deprecatedAt      DateTime?
  deprecationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactionsAsA MedicationInteraction[] @relation("InteractionSaltA")
  interactionsAsB MedicationInteraction[] @relation("InteractionSaltB")
  lineItems       PrescriptionLineItem[]

  @@index([category])
  @@index([schedule])
  @@index([isTelemedicineEligible])
  @@index([isActive])
  @@index([atcCode])
  @@map("medication_salts")
}

/// Drug-drug interaction matrix (Lexicomp-aligned severity).
/// Symmetric — query both directions with @@unique constraint.
model MedicationInteraction {
  id          String              @id @default(uuid()) @db.Uuid
  saltAId     String              @db.Uuid
  saltA       MedicationSalt      @relation("InteractionSaltA", fields: [saltAId], references: [id])
  saltBId     String              @db.Uuid
  saltB       MedicationSalt      @relation("InteractionSaltB", fields: [saltBId], references: [id])
  severity    InteractionSeverity
  description String              @db.Text
  mechanism   String?             @db.Text
  management  String?             @db.Text
  references  Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([saltAId, saltBId])
  @@index([severity])
  @@map("medication_interactions")
}

/// ICD-10 K00-K14 hierarchical dental conditions.
/// Source: WHO ICD-10 (K10 intentionally skipped — historical numbering).
/// 3-level: chapter (K00-K14) → subchapter (K00.0) → specific (K00.01)
model DentalCondition {
  id String @id @default(uuid()) @db.Uuid

  // ── ICD-10 hierarchy ──
  icd10Code      String  @unique
  chapterCode    String
  subchapterCode String?
  parentCode     String?

  // ── Display ──
  name             String
  nameLocalized    Json?
  shortDescription String?
  fullDescription  String? @db.Text

  // ── Classification ──
  category    String
  subcategory String?
  isLeafCode  Boolean @default(false)

  // ── Cross-references ──
  excludesCodes String[]
  includesCodes String[]
  seeAlsoCodes  String[]

  // ── Clinical context ──
  prevalencePercent  Float?
  typicalSeverity    UrgencyLevel @default(ROUTINE)
  isUrgent           Boolean      @default(false)
  requiresXray       Boolean      @default(false)
  affectedAgeGroups  Json?
  riskFactors        Json?
  symptoms           Json?
  homeRemedies       Json?
  typicalMedications Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterCode])
  @@index([subchapterCode])
  @@index([parentCode])
  @@index([isUrgent])
  @@index([isLeafCode])
  @@index([isActive])
  @@map("dental_conditions")
}

/// 50 patient archetypes for archetype-driven seed generation.
/// Based on NFHS-5 demographic distribution + Indian healthcare access patterns.
model PatientArchetype {
  id           String  @id @default(uuid()) @db.Uuid
  archetypeKey String  @unique
  name         String
  description  String? @db.Text

  // ── Demographics (NFHS-5 informed) ──
  locale           ArchetypeLocale
  ageMin           Int
  ageMax           Int
  gender           Json
  sesTiers         Json
  residence        Json
  educationLevels  Json
  populationWeight Float           @default(1.0)

  // ── Clinical patterns ──
  primaryConditionIcd10   String
  comorbidConditionsIcd10 Json?
  pregnancyStatus         Json
  smokingStatus           Json

  // ── Cultural ──
  preferredLanguages Json
  insuranceLikely    Json
  referralChannels   Json
  behaviors          Json?

  // ── Compliance / safety constraints ──
  safetyConstraints Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale])
  @@index([primaryConditionIcd10])
  @@index([isActive])
  @@map("patient_archetypes")
}

/// Versioned system prompts — A/B testing + rollout governance.
model SystemPrompt {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  version        String
  useCase        PromptUseCase
  content        String        @db.Text
  contentLocale  LocaleCode    @default(en)
  modelTarget    String?
  temperature    Float?
  maxTokens      Int?
  isActive       Boolean       @default(true)
  isCanonical    Boolean       @default(false)
  rolloutPercent Int           @default(0)
  deprecatedAt   DateTime?
  releasedById   String?       @db.Uuid
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([name, version, contentLocale])
  @@index([useCase])
  @@index([isActive, isCanonical])
  @@map("system_prompts")
}

/// Prescription line items (medical-legal accountability table).
/// Every item carries safety check audit trail per NMC + IP.
model PrescriptionLineItem {
  id               String          @id @default(uuid()) @db.Uuid
  prescriptionId   String          @db.Uuid
  prescription     Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationSaltId String?         @db.Uuid
  medicationSalt   MedicationSalt? @relation(fields: [medicationSaltId], references: [id])

  medicationNameLegacy String?
  brandNameSuggested   String?

  // ── Dosing (NMC mandatory: drug name, dose, route, frequency, duration) ──
  dosageMg              Decimal?    @db.Decimal(10, 4)
  dosageUnit            String?     @default("mg")
  frequency             String
  duration              String
  durationDays          Int?
  routeOfAdministration String?     @default("oral")
  instructions          String?     @db.Text
  instructionsLocale    LocaleCode?

  // ── Safety check audit trail (per medication) ──
  allergyChecked           Boolean @default(false)
  pregnancyChecked         Boolean @default(false)
  bloodThinnerChecked      Boolean @default(false)
  pediatricDoseAdjusted    Boolean @default(false)
  geriatricDoseAdjusted    Boolean @default(false)
  interactionChecked       Boolean @default(false)
  renalAdjustmentApplied   Boolean @default(false)
  hepaticAdjustmentApplied Boolean @default(false)

  // ── Review status ──
  reviewStatus LineItemReviewStatus @default(NOT_REVIEWED)
  reviewNotes  String?              @db.Text

  sequenceNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prescriptionId])
  @@index([medicationSaltId])
  @@index([reviewStatus])
  @@map("prescription_line_items")
}

/// DPDP Rules 2025 — processing logs (1-year minimum retention).
/// Source: DPDP Rules 2025 Rule 6 — security safeguards.
model ProcessingLog {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @db.Uuid
  patientId      String? @db.Uuid
  consultationId String? @db.Uuid

  purpose        ProcessingPurpose
  dataCategories String[]
  legalBasis     String

  accessedBy     String?
  accessedFromIp String?
  accessedFromUa String?
  consentVersion String?

  success      Boolean @default(true)
  errorMessage String?

  retentionUntil DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([patientId])
  @@index([consultationId])
  @@index([purpose])
  @@index([retentionUntil])
  @@index([createdAt])
  @@map("processing_logs")
}

/// DPDP-compliant deletion request (48-hour erasure notice rule).
/// Source: DPDP Rules 2025 — Erasure notice 48hr before deletion.
model DeletionRequest {
  id                String  @id @default(uuid()) @db.Uuid
  requestedByUserId String? @db.Uuid
  targetUserId      String? @db.Uuid
  targetPatientId   String? @db.Uuid

  requestType   String
  requestReason String? @db.Text

  // ── DPDP 48-hour erasure notice ──
  noticeIssuedAt       DateTime?
  noticeAcknowledgedAt DateTime?

  // ── Lifecycle ──
  status              String    @default("PENDING")
  scheduledDeletionAt DateTime?
  deletedAt           DateTime?
  cancellationReason  String?

  // ── Verification ──
  verifiedByMethod String?
  verifiedAt       DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestedByUserId])
  @@index([targetUserId])
  @@index([targetPatientId])
  @@index([status])
  @@index([scheduledDeletionAt])
  @@map("deletion_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// EXPERIMENT ASSIGNMENT — Wave 12 A/B harness
// ─────────────────────────────────────────────────────────────────────────
//
// Stores per-user variant assignment for an experiment. Used by:
//   - prisma/seeds/continuous-training/experiments/experiment-store.ts
//   - prisma/seeds/continuous-training/experiments/srm-detector.ts
//
// Determinism: bucketHash (0-99) is stable per (experimentKey, userId) so
// a user always falls in the same variant across requests. assignmentReason
// distinguishes 'NEW_RANDOM' (first exposure) vs forced-variant overrides.
//
// Reference: Kohavi et al. 2020 (Trustworthy Online Controlled Experiments)
// + LinkedIn XLNT + Spotify Confidence harness conventions.

model ExperimentAssignment {
  id               String  @id @default(cuid())
  experimentKey    String
  userId           String
  variantKey       String
  bucketHash       Int // 0–99, deterministic per (experimentKey, userId)
  assignmentReason String  @default("NEW_RANDOM") // NEW_RANDOM | FORCED | RECONCILED
  metricExposed    Boolean @default(false)
  conversionEvents Json    @default("[]")
  conversionValue  Float   @default(0)

  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  @@unique([experimentKey, userId])
  @@index([experimentKey, variantKey])
  @@index([userId])
  @@map("experiment_assignments")
}

// ═══════════════════════════════════════════════════════════════
// TABLE: JudgeRun — Task #44
// One row per LLM-as-judge grading attempt.
// Tracks judge model, cost, latency, score, reasoning, status.
// Foundation for: judge calibration drift detection (Month 6+),
// cost attribution (Month 18+), and audit trail.
// ═══════════════════════════════════════════════════════════════

model JudgeRun {
  id                    String              @id @default(cuid())
  consultationMessageId String              @db.Uuid
  consultationMessage   ConsultationMessage @relation("AllJudgeRunsForMessage", fields: [consultationMessageId], references: [id], onDelete: Cascade)

  judgeModel         String // "claude-haiku-4-5-20251001" — exact model string used
  judgePromptVersion String // semver of judge prompt template
  rubricVersion      String // semver of the 1-5 scoring rubric
  parsedScore        Int // 1-5 integer score (final)
  rawScore           Float? // raw model output before clamping
  reasoning          String @db.Text
  flags              Json? // { disagrees_with_human: true, low_confidence: false, ... }

  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(10, 6)
  latencyMs    Int?

  status       JudgeRunStatus @default(PENDING)
  errorMessage String?        @db.Text
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  // Inverse relation back from ConsultationMessage.judgeRun (latest pointer)
  primaryForMessages ConsultationMessage[]

  @@index([consultationMessageId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([parsedScore, status])
  @@map("judge_runs")
}

// ═══════════════════════════════════════════════════════════════
// TABLE: DataAssetVersion — Task #44
// Content-addressed dataset versioning (DVC-equivalent, Postgres-native).
// Each training dataset export gets SHA-256 content hash + semver.
// Parent-child lineage enables reproducibility — critical for DPDP audit.
// ═══════════════════════════════════════════════════════════════

model DataAssetVersion {
  id          String        @id @default(cuid())
  assetKind   DataAssetKind
  semver      String // e.g., "v1.0.0" — manually bumped per export batch
  contentHash String // SHA-256 over canonical-JSON of all records
  recordCount Int
  manifestUrl String? // S3/R2 URL — null until Month 6 export pipeline ships
  metadata    Json? // arbitrary annotations (training config, ε-budget, etc.)

  // Lineage — track derivations (e.g., v2.0 derived from v1.0 + new labels)
  parentVersionId String?
  parentVersion   DataAssetVersion?  @relation("AssetLineage", fields: [parentVersionId], references: [id])
  derivedVersions DataAssetVersion[] @relation("AssetLineage")

  createdById String?  @db.Uuid
  createdBy   User?    @relation("DataAssetVersionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?  @db.Uuid

  @@unique([assetKind, semver]) // can't double-version same asset
  @@unique([assetKind, contentHash]) // identical content = same version (dedup)
  @@index([assetKind, createdAt(sort: Desc)])
  @@index([parentVersionId])
  @@map("data_asset_versions")
}
