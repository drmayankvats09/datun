  // ── B-1 v2: Strict template fields (Meta July 2025 enforcement) ──
  templateName       WhatsAppTemplateName?
  templateNameLegacy String?
  templateCategory   WhatsAppTemplateCategory?
  templateLocale     LocaleCode                @default(en)

  // ── Phone fields ──
  phoneNumber         String
  recipientPhone      String?
  senderPhoneNumberId String?

  // ── Provider IDs ──
  waMessageId   String?
  metaMessageId String?

  // ── Lifecycle ──
  status          WhatsAppStatus    @default(QUEUED)
  statusUpdatedAt DateTime?
  failureReason   String?
  direction       WhatsAppDirection @default(OUTBOUND)
  content         String?           @db.Text
  provider        WhatsAppProvider  @default(META)

  // ── B-1 v2: Per-message pricing tracking (Meta July 2025 model) ──
  costPaisa       Int?
  pricingCategory String?

  // ── B-1 v2: Lifecycle tracking ──
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  scheduledFor DateTime?

  // ── B-1 v2: Generic relation ──
  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([consultationId])
  @@index([waMessageId])
  @@index([metaMessageId])
  @@index([status])
  @@index([scheduledFor])
  @@index([patientId])
  @@index([templateCategory])
  @@map("whatsapp_messages")
}

