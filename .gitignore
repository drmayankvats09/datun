# ═══════════════════════════════════════════════════════════════
# DATUN — Git Ignore Configuration
# Pattern: Stripe, Vercel, Linear .gitignore conventions
# Day 1 hardening — proactive security defense layer
# ═══════════════════════════════════════════════════════════════

# ── Dependencies ──
node_modules
.pnp
.pnp.js

# ── Local env files (production secrets NEVER in git) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
.env.local.bak

# ── Testing ──
coverage

# ── Turbo ──
.turbo

# ── Vercel ──
.vercel

# ── Build Outputs ──
.next/
out/
build
dist

# ── TypeScript build info ──
*.tsbuildinfo

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS ──
.DS_Store
Thumbs.db

# ── SSL/TLS Certificates & Keys (NEVER commit) ──
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ── Secrets files (common dev mistake patterns) ──
secrets.json
secrets.yml
secrets.yaml

# ── Database files (DPDP — patient data NEVER in git) ──
*.sqlite
*.sqlite3
*.db
*.dump

# ── AI/Dev Tool Artifacts ──
.aider*
.history/
tmp/
temp/

# ── Backup folders & Archives ──
Datun-Backup/
*.zip
*.tar.gz

# ── Sentry ──
.sentryclirc
pnpm

# Less pager log file (Windows path artifacts)
ersAdmin*
